#include <stm32f4xx_hal.h>

void init_inputs() {
	// Enable Port A
	RCC->AHB1ENR |= (1UL << 0);

	// Configure PA0 as input
	GPIOA->MODER &= ~(3UL << 0);

	// Configure PA0 as pull-up
	GPIOA->PUPDR &= ~(3UL << 0);
	GPIOA->PUPDR |= (1UL << 0);
}

void init_outputs() {
	// Enable Port B
	RCC->AHB1ENR |= (1UL << 1);

	// Configure PB0 as output
	GPIOB->MODER &= ~(3UL << 0);
	GPIOB->MODER |= (1UL << 0);

	// Configure PB0 as pull up
	GPIOB->PUPDR &= ~(3UL << 0);
	GPIOB->PUPDR |= (1UL << 0);
}

int main() {
	init_inputs();
	init_outputs();

	int current_state = 0, previous_state = 1, counter = 0;
	while (1) {
		current_state = (GPIOA->IDR & (1UL << 0)) ? 1 : 0;
		if (current_state == 1 && previous_state == 0) {
			counter++;

			if (counter > 5) {
				counter = 1;
			}

			for (int i = 0; i < counter; i++) {
				GPIOB->BSRR = (1UL << 0);
				for (int j = 0; j < 500000; j++);

				GPIOB->BSRR = (1UL << 16);
				for (int j = 0; j < 500000; j++);
			}

			previous_state = current_state;
			for (int i = 0; i < 500000; i++);
		}
	}
	return 0;
}
