/*
 * Part 2
 */

void init_inputs() {
	// Enable Port A
	RCC->AHB1ENR |= (1UL << 0);

	// Configure PA0 and PA1 as inputs
	GPIOA->MODER &= ~((3UL << 0) | (3UL << 2));

	// Configure PA0, PA1 as pull-down
	GPIOA->PUPDR &= ~((3UL << 0) | (3UL << 2));
	GPIOA->PUPDR |= ((2UL << 0) | (2UL << 2));
}

void init_outputs() {
	// Enable Port B
	RCC->AHB1ENR |= (1UL << 1);

	// Configure PB0 as output
	GPIOB->MODER &= ~(3UL << 0);
	GPIOB->MODER |= (1UL << 0);

	// Configure PB0 as pull-up/pull-down
	GPIOB->PUPDR &= ~(3UL << 0);
	GPIOB->PUPDR |= (1UL << 0);
}

int main () {
	init_inputs();
	init_outputs();

	while (1) {
		if ((GPIOA->IDR & (1UL << 0)) && ((GPIOA->IDR) & (1UL << 1))) {
			GPIOB->BSRR = (1UL << 0);
		} else {
			GPIOB->BSRR = (1UL << 16);
		}
	}
}
