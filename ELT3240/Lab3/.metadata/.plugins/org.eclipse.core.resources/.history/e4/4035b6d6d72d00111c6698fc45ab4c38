#include <stm32f4xx_hal.h>

void init_inputs() {
	// Enable Port A
	RCC->AHB1ENR |= (1UL << 0);

	// Configure PA0 as input
	GPIOA->MODER &= ~(3UL << 0);

	// Configure PA0 as pull-up
	GPIOA->PUPDR &= ~(3UL << 0);
	GPIOA->PUPDR |= (1UL << 0);
}

void init_outputs() {
	// Enable Port B
	RCC->AHB1ENR |= (1UL << 1);

	// Configure PB0 as output
	GPIOB->MODER &= ~(3UL << 0);
	GPIOB->MODER |= (1UL << 0);

	// Configure PB0 as pull up
	GPIOB->PUPDR &= ~(3UL << 0);
	GPIOB->PUPDR |= (1UL << 0);
}

int main() {
	init_inputs();
	init_outputs();


	while (1) {

	}
	return 0;
}
