#include "dht11.h"

void TIM2_IRQHandler() {
	if (TIM2->SR & (1UL << 0)) {
		TIM2->SR &= ~(1UL << 0);
	}
}

void set_delay(uint32_t us) {
	// Enable clock for TIM2 (General purpose 32-bit timer)
	RCC->APB1ENR |= (1UL << 0);

	// Configure prescaler
	TIM2->PSC = 80 - 1;

	// Set delay value
	TIM2->ARR = us - 1;
	TIM2->CNT = 0;
	TIM2->SR &= ~(1UL << 0);

	// Enable update interrupt
	TIM2->DIER |= (1UL << 0);

	// Enable TIM2 IRQ in NVIC
	NVIC_EnableIRQ(TIM2_IRQn);

	// Start timer
	TIM2->CR1 |= (1UL << 0);

	// Enter Sleeper mode (CPU stops, Timer keeps running)
	// CPU will wake up when the timer finishes and triggers the interrupt
	while (!(TIM2->SR & (1UL << 0))) {
		__WFI();
	}

	// Stop timer
	TIM2->CR1 &= ~(1UL << 0);
	NVIC_DisableIRQ(TIM2_IRQn);
}

void set_pin(GPIO_TypeDef *port, uint16_t pin, uint32_t mode, uint32_t pupd) {
	// Enable clock for specified port
	if (port == GPIOB) RCC->AHB1ENR |= (1UL << 1);
	else if (port == GPIOC) RCC->AHB1ENR |= (1UL << 2);
	else RCC->AHB1ENR |= (1UL << 0);

	// Set input or output for pin
	port->MODER &= ~(3UL << (pin * 2));
	if (mode == 1) port->MODER |= (1UL << (pin * 2));

	// Set pull-up or pull-down for pin
	port->PUPDR &= ~(3UL << (pin * 2));
	if (pupd == 1) port->PUPDR |= (1UL << (pin * 2));
	if (pupd == 2) port->PUPDR |= (2UL << (pin * 2));
}

void send_start_signal(GPIO_TypeDef *port, uint16_t pin) {
	// Set pin to pul-up output
	set_pin(port, pin, 1, 1);

	// Pull low for 18ms
	port->ODR &= ~(1UL << pin);
	set_delay(18000);

	// Pull high for DHT11 response (20-40us)
	port->ODR |= (1UL << pin);
	set_delay(30);

	// Set pin to pull-up input
	set_pin(GPIOA, pin, 0, 1);
}

