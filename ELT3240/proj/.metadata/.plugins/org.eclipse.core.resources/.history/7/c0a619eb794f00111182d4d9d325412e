#ifndef MPU6050_DMA_H
#define MPU6050_DMA_H

#include <math.h>
#include <stm32f4xx.h>

/* MPU6050 registers addresses */
#define MPU6050_ADDR 0x68 /* MPU6050 7-bit address (0x69 if AD0 is high)*/
#define CONFIG 0x1A /* FSYNC And DLPF Config */
#define GYRO_CONFIG 0x1B /* Gyroscope Config */
#define ACCEL_CONFIG 0x1C /* Accelerometer Config */
#define PWR_MGMT_1 0x6B /* Power Management Config */
#define SMPRT_DIV 0x19 /* Sample Rate Divider Config */
#define ACCEL_XOUT_H 0x3B /* First data register (burst) */

extern volatile float pitch; // Around Y axis
extern volatile float roll; // Around X axis
extern volatile float yaw; // Around Z axis
extern volatile int obstacle_detected;

void I2C1_Init();
void DMA1_Init();
void MPU6050_Write_Register(uint8_t reg, uint8_t data);
void MPU6050_Init();
void MPU6050_Start_DMA_Read();

#endif
