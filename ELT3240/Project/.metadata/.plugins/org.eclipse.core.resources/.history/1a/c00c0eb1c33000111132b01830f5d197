/**
 * Custom DHT11 library, providing functionalities to interface
 * with the DHT11 temperature and humidity sensor
 * for NUCLEO-F401RE board.
 *
 * Author: Do Hoang Gia Bao
 */

#pragma once

#include <stm32f4xx_hal.h>

/**
 * Enable the Timer and wait for the update flag to set.
 */
void TIM2_config();

/**
 * Set delay in micro-second
 *
 * @param: time value (us)
 */
void delay_us(uint32_t us);

/**
 * Set delay in mili-second
 *
 * @param: time value (ms)
 */
void delay_ms(uint32_t ms);

/**
 * Set up pin function.
 * Only support port A, port B and port C.
 * Only support input or output pin.
 * Only support pull-up or pull-down or no pull-up/pull-down.
 *
 * @param: 	port - Port to enable clock
 * 			pin  - Pin number
 * 			mode - Set input (0) or output (1)
 * 			pupd - Set no pull-up/pull-down (0) or pull-up (1) or pull-down (2)
 */
void set_pin(GPIO_TypeDef *port, uint16_t pin, uint32_t mode, uint32_t pupd);

/**
 * Read 40-bit data from DHT11.
 *
 * @param: port - port name, pin - pin number
 * @return: 0 if successful, -1 if no response, -3 if checksum fails
 */
int read_raw_data();

/**
 * Send start signal to the DHT11 sensor to initiate a data read.
 * Set the data pin to low for ~18ms then high, and finally
 * setting the pin to input to read data.
 *
 * @param: port - Port name, pin - Pin number
 */
void send_start_signal(GPIO_TypeDef *port, uint16_t pin);

/**
 * Read a byte of data from DHT11 sensor during communication process.
 *
 * @param: port - port name, pin - pin number.
 * @return: A byte of data read from sensor.
 */
uint8_t read_byte(GPIO_TypeDef *port, uint16_t pin);

/**
 * Read and returns the temperature from DHT11 sensor.
 *
 * @return: Temperature value or -1 if failed.
 */
int get_temperature(GPIO_TypeDef *port, uint16_t pin);

/**
 * Read and returns the humidity from DHT11 sensor.
 *
 * @return: Humidity value or -2 if failed.
 */
int get_humidity(GPIO_TypeDef *port, uint16_t pin);
