void checkTouch() {
  if (ts.touched()) {
    TS_Point p = ts.getPoint();
    int16_t x = map(p.x, 230, 3800, 0, DISPLAY_WIDTH);
    int16_t y = map(p.y, 340, 3900, 0, DISPLAY_HEIGHT);

    static unsigned long lastTouchTime = 0;
    if (millis() - lastTouchTime > 400) { 
      if (x > 40 && x < (DISPLAY_WIDTH - 40) && y > 70 && y < 150) {
        lastTouchTime = millis();
        isArmed = !isArmed;
        Blynk.virtualWrite(V1, isArmed ? 1 : 0);
        drawUI();
      }
    }
  }
}

void setup() {
  Serial.begin(115200);
  delay(500); 
  Serial.println("Connecting to WiFi and Blynk Server...");
  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);  

  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);

  Blynk.virtualWrite(V0, PIRMessage);
  Blynk.virtualWrite(V2, batteryMessage);

  tft.init();
  tft.setRotation(1);

  mySpi.begin(XPT2046_CLK, XPT2046_MISO, XPT2046_MOSI, XPT2046_CS);
  ts.begin(mySpi);
  ts.setRotation(1);
  drawUI();
  
  Serial.println("\nInitializing Continuous BLE Client...");
  BLEDevice::init("CYD_HUB_CLIENT");
  startScanning();
}

void loop() {
  Blynk.run();
  
  if (doConnect) {
    delay(200); 
    if (connectToServer()) {
      Serial.println("System secure. Monitoring notifications...\n");
    } else {
      Serial.println("Failed to link. Restarting scan loop.");
    }
    doConnect = false;
  } else if (!doConnect) {
    checkTouch();
  }

  if (alertActive && (millis() - alertStartTime >= 10000)) {
    alertActive = false;
    PIRMessage = "No Motion Detected";
    Blynk.virtualWrite(V0, PIRMessage);
    drawUI();
  }

  if (!connected && !doConnect && !isScanning) {
    delay(500); 
    startScanning();
  }

  delay(100); 
}
