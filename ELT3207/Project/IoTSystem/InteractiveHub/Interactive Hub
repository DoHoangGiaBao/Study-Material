static void notifyCallback(BLERemoteCharacteristic *pBLERemoteCharacteristic, uint8_t *pData, size_t length, bool isNotify) {
  String receivedMessage = "";
  for (size_t i = 0; i < length; i++) {
    receivedMessage += (char)pData[i];
  }
  
  Serial.println("ALERT -> Notification from Sensor Node: " + receivedMessage);
  struct tm timeInfo;
  String date = "";
  if (receivedMessage.startsWith("Motion Detected")) {
    if (!getLocalTime(&timeInfo)) {
      date = " [Time Unknown]";
    } else {

      char timeBuf[20];

      strftime(timeBuf, sizeof(timeBuf), " %m/%d %H:%M", &timeInfo);
      date = String(timeBuf);
    }

    PIRMessage = "Motion Detected" + date;
    batteryMessage = receivedMessage.substring(15); 
  } else {
    PIRMessage = "No Motion Detected";
    batteryMessage = "--";
  }

  Blynk.virtualWrite(V0, PIRMessage);
  Blynk.virtualWrite(V2, batteryMessage);

  drawUI();
  alertActive = true;
  alertStartTime = millis();

  // Trigger Disconnection
  if (pClient != nullptr && connected) {
    Serial.println("Data received successfully. Disconnecting from sensor node...");
    pClient->disconnect(); 
  }
}

class CYDClientCallback : public BLEClientCallbacks {
  void onConnect(BLEClient *pclient) {
    connected = true;
    Serial.println("Successfully connected to server!");
  }

  void onDisconnect(BLEClient *pclient) {
    connected = false;
    isScanning = false;
    Serial.println("Device disconnected cleanly. Re-initiating background scan...");
  }
};

static CYDClientCallback clientCallbacks;

bool connectToServer() {
  Serial.print("Forming a connection to: ");
  Serial.println(PIRDevice.getAddress().toString().c_str());

  if (pClient == nullptr) {
    pClient = BLEDevice::createClient();
    pClient->setClientCallbacks(&clientCallbacks);
  }

  if (!pClient->connect(&PIRDevice)) {
    Serial.println(" - Connection handshake failed.");
    return false;
  }

  pClient->setMTU(517); 

  BLERemoteService *pRemoteService = pClient->getService(serviceUUID);
  if (pRemoteService == nullptr) {
    pClient->disconnect();
    return false;
  }

  pRemoteCharacteristic = pRemoteService->getCharacteristic(charUUID);
  if (pRemoteCharacteristic == nullptr) {
    pClient->disconnect();
    return false;
  }

  if (pRemoteCharacteristic->canNotify()) {
    pRemoteCharacteristic->registerForNotify(notifyCallback);
  } else {
    pClient->disconnect();
    return false;
  }

  connected = true;
  return true;
}

class PIRAdvertisedDeviceCallbacks : public BLEAdvertisedDeviceCallbacks {
  void onResult(BLEAdvertisedDevice advertisedDevice) {
    if (doConnect || connected) return; 

    if (advertisedDevice.haveServiceUUID() && advertisedDevice.isAdvertisingService(serviceUUID)) {
      Serial.println("\n>> TARGET SENSOR DETECTED! Stopping scan...");
      BLEDevice::getScan()->stop(); 
      PIRDevice = advertisedDevice; 
      doConnect = true;
      isScanning = false; 
    }  
  }  
};

static PIRAdvertisedDeviceCallbacks scanCallbacks;

void scanCompleteCallback(BLEScanResults scanResults) {
  Serial.println("Scan window finished. Preparing next cycle...");
  isScanning = false; 
}

void startScanning() {
  Serial.print("Free heap before scan: ");
  Serial.println(ESP.getFreeHeap()); 

  Serial.println("Starting a new 4-second scan burst...");
  BLEScan *pBLEScan = BLEDevice::getScan();
  
  pBLEScan->setAdvertisedDeviceCallbacks(&scanCallbacks);
  pBLEScan->setInterval(1349);
  pBLEScan->setWindow(449);
  pBLEScan->setActiveScan(true);
  
  pBLEScan->start(4, scanCompleteCallback, false); 
  isScanning = true;
}

